# Public canonical origin. Use the production site origin in Production.
# Safe default when empty: http://localhost:3000 and fail-closed noindex.
NEXT_PUBLIC_SITE_URL=

# Contact delivery is fail-closed unless this is exactly "true" and every
# setting required for the current environment is valid. Empty means disabled.
CONTACT_FORM_ENABLED=

# Preview stays disabled unless this is exactly "true" as well. Never point
# Preview at Production sender or recipient mailboxes. Empty means disabled.
CONTACT_PREVIEW_ENABLED=

# Comma-separated exact origins; no paths or wildcards. Plain HTTP is accepted
# only for localhost/127.0.0.1 in local development. Required when enabled;
# for local development, use http://localhost:3000.
CONTACT_ALLOWED_ORIGINS=

# SMTP delivery. Port 465 enables implicit TLS; other ports use the transport
# provider's negotiated connection. Supply secrets only through local/Vercel
# environment settings, never in this committed example.
SMTP_HOST=
# Safe default when empty: 587.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=
CONTACT_PREVIEW_TO=
CONTACT_PREVIEW_FROM=

# Preview and Production require an HTTPS distributed rate-limit endpoint,
# bearer token and an independent HMAC secret of at least 32 characters. Local
# development uses a bounded in-memory limiter; its key secret is optional.
CONTACT_RATE_LIMIT_ENDPOINT=
CONTACT_RATE_LIMIT_TOKEN=
CONTACT_RATE_LIMIT_KEY_SECRET=
# Safe defaults when empty: 5 requests per 600000 ms.
CONTACT_RATE_LIMIT_MAX=
CONTACT_RATE_LIMIT_WINDOW_MS=

# Preview and Production require both Turnstile keys. The public site key may
# be exposed to the browser; the secret key must remain server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET_KEY=

# Optional anti-abuse timing bounds. Safe defaults when empty: minimum fill
# time 3000 ms and maximum form age 7200000 ms.
CONTACT_MIN_FILL_MS=
CONTACT_MAX_FORM_AGE_MS=

# Optional ISO-8601 build timestamp exposed by /api/health. Vercel supplies
# VERCEL_ENV and VERCEL_GIT_COMMIT_SHA automatically; do not duplicate them.
BUILD_TIME=
