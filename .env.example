# Public canonical origin. Use the production site origin in Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact delivery is fail-closed until a configured provider is selected.
CONTACT_PROVIDER=disabled
CONTACT_TO=
CONTACT_FROM=

# SMTP provider settings. Leave blank when CONTACT_PROVIDER is disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
