{
  "name": "digital-activision",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.19.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:a11y": "playwright test tests/a11y --project=chromium",
    "test:visual": "playwright test tests/visual --project=chromium",
    "audit:security": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run lint && npm run typecheck && npm run test && npm run build",
    "quality:full": "npm run quality && npm run test:e2e && npm run test:a11y && npm run test:visual"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "lucide-react": "^0.542.0",
    "next": "16.2.12",
    "next-intl": "4.13.2",
    "nodemailer": "9.0.3",
    "postcss": "8.5.23",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.62.0",
    "sharp": "0.35.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
